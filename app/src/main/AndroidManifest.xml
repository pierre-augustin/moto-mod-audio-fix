<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
         signature|privileged permission: only granted when the app is
         installed as a privileged system app (/system/priv-app) AND
         whitelisted in a privapp-permissions file. See README.md and
         device-files/privapp-permissions-modaudiofix.xml.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />

    <!--
         "normal" protection level (auto-granted, no whitelist needed):
         required to receive the com.motorola.mod.action.* broadcasts sent by
         com.motorola.modservice. Without it the broadcast is filtered out
         silently, with no log at all.
    -->
    <uses-permission android:name="com.motorola.mod.permission.MOD_ACCESS_INFO" />

    <!--
         android:persistent: privileged system apps only. The system starts the
         process at boot and keeps it alive, so DockWatcher can repair
         force_use after user switches and audioserver restarts.
    -->
    <application
        android:name=".ModAudioFixApp"
        android:persistent="true"
        android:directBootAware="true"
        android:label="Mod Audio Fix"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_lock_silent_mode_off">

        <!--
             directBootAware is REQUIRED: the mod is enumerated during boot,
             before the first unlock (user state RUNNING_LOCKED). Without it
             Android does not start the app and MOD_ENUMERATION_DONE is lost
             (broadcast record shows no receiver). The app uses no
             credential-encrypted storage.
             exported=true is required to receive a broadcast sent by another
             package (com.motorola.modservice).
        -->
        <receiver
            android:name=".ModAttachReceiver"
            android:exported="true"
            android:enabled="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="com.motorola.mod.action.MOD_ENUMERATION_DONE" />
                <action android:name="com.motorola.mod.action.MOD_DETACH" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
