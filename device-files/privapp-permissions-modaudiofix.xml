<?xml version="1.0" encoding="utf-8"?>
<!--
     Goes to /system/etc/permissions/ (same partition as the priv-app APK).
     Without it, Android silently denies the signature|privileged permission
     even though the app lives in a priv-app directory. See README.md.
-->
<permissions>
    <privapp-permissions package="dev.paugustin.modaudiofix">
        <permission name="android.permission.MODIFY_AUDIO_ROUTING"/>
    </privapp-permissions>
</permissions>
