From f1d2b041fffa308958ce54c4216a06fdd34e1047 Mon Sep 17 00:00:00 2001
From: pierre-augustin <pierre.augustin@gmail.com>
Date: Fri, 2 Oct 2026 16:10:28 +0200
Subject: [PATCH] beckham: Shim HIDL health 2.0 for Motorola health service

motorola.hardware.health@1.0-service calls
android.hardware.health@2.0::IHealth::getService() without a null check,
then IHealth::getCapacity(), in MotHealth::getModBatteryProperties(). Only
the AIDL health HAL is registered now, so the service crashes whenever a
battery mod (e.g. JBL SoundBoost) is attached, and the mod battery level is
never shown (BatteryService: "getModBatteryProperties fail!",
mod_level=-1).

Add libmothealth_shim from msm8998-common to the blob.

Test: JBL SoundBoost attached, no more crashes of the Motorola health
service, BatteryService no longer fails and the mod battery level shows in
the notification shade.

Change-Id: I8ec35af4574cc67cda9f1ee1671ba6df0e909da9
---
 extract-files.py | 1 +
 1 file changed, 1 insertion(+)

diff --git a/extract-files.py b/extract-files.py
index e5c4f4c..65914ea 100755
--- a/extract-files.py
+++ b/extract-files.py
@@ -49,6 +49,7 @@ blob_fixups: blob_fixups_user_type = {
         .add_needed('libmemset_shim.so'),
     'vendor/bin/hw/motorola.hardware.health@1.0-service': blob_fixup()
         .add_needed('libbase_shim.so')
+        .add_needed('libmothealth_shim.so')
         .replace_needed('libhidlbase.so', 'libhidlbase-v32.so')
         .replace_needed('libutils.so', 'libutils-v32.so'),
     'vendor/etc/init/android.hardware.biometrics.fingerprint@2.1-service-beckham.rc': blob_fixup()
